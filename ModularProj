// this function makes a random number and puts the random nuber into the array
// start of function runction this function wants a code[] array to be declared in the function with 3 indexs
void random(int code[3]) {

    // determines the seed value w a ttime of 0
    srand(time(0));
    // generates a random number and puts them in index [0] and [1] in the array makes the number 1-9
    code[0] = rand() % 10;
    code[1] = rand() % 10;
    // makes sure that no index can equal eachother and if one random number equals eachother regenerate it
    while (code[1] == code[0]) {
        code[1] = rand() % 10;
    }
    code[2] = rand() % 10;
    while (code[2] == code[0] || code[2] == code[1]) {
        code[2] = rand() % 10;
    }

} // end of function random()


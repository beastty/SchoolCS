// start of the function isTriangle. This function checks if the functions angle adds to the needed amount for the triangle to be a triangle.
// expects 3 integers which would be counted as the angle.
bool isTriangle(int x, int y, int z) {
    // if the angles arre a triangle and the angles are greater then 0 and adds to 180 return

    return (x + y + z == 180 && x > 0 && y > 0 && z > 0);

} // end of function isTriangle

// start of the function triangleType
//  This function asks for 3 diffrent ints as angles thgen determines what type of triangle it is.
void triangleType(int x, int y, int z) {
    //bool isTri = isTriangle(x,y,z);
    // checks if one of the angles are equal to 90 degrees and if one of the angles are equal to 90 degrees output this is a right =triangle to console
    if (x == 90 || y == 90 || z == 90) {
        cout << "This is a Right triangle" << endl;
    }
    // checks if all the angles are equal to eachother and if they are its a equalitartel triangle
    if (x == y && y == z) {
        cout << "You have a Equilateral triangle" << endl;
    } else if (x != y && y != z && x != z ) { // checks to make sure no angle is equal to eachother and if no angle equal's eachother its a Scalene triangle
        cout << "You have a Scalene triangle" << endl;
    } else {
        // if one of the angles are eequal to eachother its a isoseles triangle
        cout << "You have a Isosceles triangle" << endl;

    }

}

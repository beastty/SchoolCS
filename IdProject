                cout << "Invalid Selection!" << endl;
        }

        printMenu(); // calls the print menu function from above so it will show it again
        cout << "What would you like to do with the ID?" << endl;
        cin >> selection;

    }



    return 0;
}
// wants a idarray and a change in the arraycount 
void pushID(int idArray[],  int &arrayCount, int size) {
    int id;

    cout << "Please enter your student ID number" << endl;
    cin >> id;
// checks to make sure that the array is not bigger then 20 and if it is not it pushes a brand new id
    // that the user has put in into the array and keeps it saved
        if (arrayCount < size) {
            idArray[arrayCount] = id;
            arrayCount += 1;
            cout << "You have " << arrayCount << " Id saved" << endl;
        } else {
            // if no room show this
            cout << "No more room for new ID's!";
        }

}



// wants to see the idarray to keep everything searched
int linearSearch(int idArray[], int arrayCount, int id) {
    // lets them check if the id is in the array and if it does returnj the id
    for (int i = 0; i < arrayCount; i++) {
        if (idArray[i] == id) {
            return i;
        }

    } return -1;
}



// expects something from the array from above and a change in the arraycount

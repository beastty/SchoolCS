    int id;
    int index;
    int replaced;
    cout << "What Id what you like to replace" << endl;
    cin >> id;
    // if no id is found return nothing
    if (index == -1 || arrayCount == 0) {
        cout << "Error no Id found" << endl;
        return;
    }

    cout << "What would you like to replace it with: " << endl;
    cin >> replaced;

    // calls the linearsearch from above and if its found replace it with the new id found

    index = linearSearch(idArray, arrayCount, id);
        idArray[index] = replaced;


}

void display(int idArray[], int arrayCount) {
    if (arrayCount == 0) {
        // if no id is found in the array at all send this
        cout << "No Id's found in the arrays!" << endl;
    }
    // if an id is found in the array print out what ids are in the array to console
    for (int i = 0; i < arrayCount; i++) {
        cout << idArray[i] << endl; // prints out the arrays
    }
}


void deleteID(int idArray[], int &arrayCount) {
    int id;
    int index;
    cout << "What Id what you like to delete: " << endl;
    cin >> id;
    index = linearSearch(idArray, arrayCount, id ); // calls the linearsearch from above to check if the id is there

    // if id is not found error
    if (index == -1) {
        cout << "Error: No Id Found." << endl;
        return;
    }
    // if id is found in the array delete that id from the array
    for (int i = index; i < arrayCount - 1; i++) {
        idArray[i] = idArray[i+1];

    }
    // minus one from the array
    arrayCount--;
}

void searchID(int idArray[], int arrayCount) {
    int index;
    int id;
    cout << "Enter ID to search for: ";
    cin >> id;
// lets you search the array for a certain id
    index = linearSearch(idArray, arrayCount, id);

    if (index == -1 || arrayCount == 0) {
        cout << "Error no Id found" << endl;
        return;
    }
// shows what ids are  found
    cout << "Stored IDs: " << id << endl;
}



int backup(int backupID[], int original[]) {

    // checks the whole array and backups everything into the other array

    for (int i = 0; i < 20; i++) {
        backupID[i] = original[i];
    }
    cout << "Backup is complete" << endl;

}
// compares if all the indexes in both the 2 arrays are equal to eachother
void compare(int backupID[], int original[], int size) {
   for (int i =0; i < size; i++) {
       if (backupID[i] != original[i]) { // checks if its not equal to eachothers array
           cout << "Array's are diffrent from eachother" << endl;
           return;
       }
   }
    cout << "Arrays are identical to eachother" << endl;
}

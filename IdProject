// calls and lets me define the functions from below
void pushID(int idArray[], int &arrayCount, int size);
void display(int idArray[], int arrayCount);
int linearSearch(int idArray[], int arrayCount, int id);
void deleteID(int idArray[], int &arrayCount);
void replaceID(int idArray[], int &arrayCount);
void searchID(int idArray[], int arrayCount);
int backup(int backupID[], int original[]);
void compare(int backupID[], int original[], int size);

int main() {
    // declares all the vars and arrays I need for below
    int idArray[20];
    int arrayCount = 0;
    int id;
    int selection;
    int backupIDs[20];
// prints the menu so the users can select that they  wanna do with the ids
    printMenu();
    cout << "What would you like to do with the ID?" << endl;
    cin >> selection;

    while (selection != 8) {
        switch (selection) {
            case 1: {
                pushID(idArray, arrayCount, 20);
            }
                break;
            case 2:
                searchID(idArray, arrayCount);
                break;
            case 3:
                replaceID(idArray, arrayCount);
                break;
            case 4:
                deleteID(idArray, arrayCount);
                break;
            case 5:
                display(idArray, arrayCount);
                break;
            case 6:
                backup(backupIDs, idArray);
                break;
            case 7:
                compare(backupIDs, idArray, arrayCount);

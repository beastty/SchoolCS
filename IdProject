void pushID(int idArray[],  int &arrayCount, int size) {
    int id;

    cout << "Please enter your student ID number" << endl;
    cin >> id;

        if (arrayCount < size) {
            idArray[arrayCount] = id;
            arrayCount += 1;
            cout << "You have " << arrayCount << " Id saved" << endl;
        } else {
            cout << "No more room for new ID's!";
        }

}




int linearSearch(int idArray[], int arrayCount, int id) {

    for (int i = 0; i < arrayCount; i++) {
        if (idArray[i] == id) {
            return i;
        }

    } return -1;
}




void replaceID(int idArray[], int &arrayCount) {
    int id;
    int index;
    int replaced;
    cout << "What Id what you like to replace" << endl;
    cin >> id;

    if (index == -1 || arrayCount == 0) {
        cout << "Error no Id found" << endl;
        return;
    }

    cout << "What would you like to replace it with: " << endl;
    cin >> replaced;



    index = linearSearch(idArray, arrayCount, id);
        idArray[index] = replaced;


}

void display(int idArray[], int arrayCount) {
    if (arrayCount == 0) {
        cout << "No Id's found in the arrays!" << endl;
    }
    for (int i = 0; i < arrayCount; i++) {
        cout << idArray[i] << endl;
    }
}


void deleteID(int idArray[], int &arrayCount) {
    int id;
    int index;
    cout << "What Id what you like to delete: " << endl;
    cin >> id;
    index = linearSearch(idArray, arrayCount, id );

    if (index == -1) {
        cout << "Error: No Id Found." << endl;
        return;
    }
    for (int i = index; i < arrayCount - 1; i++) {
        idArray[i] = idArray[i+1];

    }
    arrayCount--;
}

void searchID(int idArray[], int arrayCount) {
    int index;
    int id;
    cout << "Enter ID to search for: ";
    cin >> id;

    index = linearSearch(idArray, arrayCount, id);

    if (index == -1 || arrayCount == 0) {
        cout << "Error no Id found" << endl;
        return;
    }

    cout << "The following id was found: " << id << endl;
}



int backup(int backupID[], int original[]) {



    for (int i = 0; i < 20; i++) {
        backupID[i] = original[i];
    }
    cout << "Backup is complete" << endl;

}

void compare(int backupID[], int original[]) {
    if (backupID[] = original[] ) {
        cout << "Arrays are identical" << endl;

    } else {
        cout << "Arrays are diffrent" << endl;
    }
}

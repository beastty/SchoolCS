#include <iostream>
using namespace std;
// Default starts at 0: GREEN =0, YElLOW=1, RED=2;
enum TrafficLight {
    GREEN,
    YELLOW,
    RED
};
// starting monday at 1 so it matches the first day of the week then adds another number for each more day
enum Day {
    MONDAY = 1,
    TUESDAY,
    WEDNESDAY,
    THURSDAY,
    FRIDAY,
    SATURDAY,
    SUNDAY
};
// starts at 1: EASY =1, MEDIUM=2, HARD =3;
enum Difficulty {
    EASY = 1,
    MEDIUM,
    HARD
};
// start of function main where all my switch statments control all my above enums and outputs proper stuff to console
int main() {
    // var declaration for user input
    int dayChoice;
    int choice;
    int dif;
    cout << "Enter light you would like to see (0 = GREEN, 1 = YELLOW, 2 = RED): " << endl;
    cin >> choice;
    // cast the int input into a TrafficLight type so I can use it on the switch stament called light
    TrafficLight light = (TrafficLight)choice;

    switch (light) {
        case GREEN:
            cout << "Current light: GREEN" << endl;
            cout << "Go!" << endl;
            break;
            case YELLOW:
            cout << "Current light: Yellow" << endl;
            cout << "Slow/Stop!" << endl;
            break;
            case RED:
            cout << "Current light: Red" << endl;
            cout << "Stop!" << endl;
            break;
            default:
            cout << "UNKNOWN" << endl;
    }
    // --- Part 2: Weekday Selection --
    cout << "\nStart of Weekday Part" << endl;

    cout << "Enter day (1 = MONDAY, 2 = TUESDAY, 3 = WEDNESDAY, 4 = THURSDAY, 5 = FRIDAY, 6 = SATURDAY, 7 = SUNDAY): " << endl;
    cin >> dayChoice;
    // cast the int input into a Day type so I can use it on the switch stament called today

    Day today = (Day)dayChoice;
    cout << "\nNumeric value: " << today << endl;

    switch (today) {
        case MONDAY:
            cout << "Today is MONDAY" << endl;
            break;
            case TUESDAY:
            cout << "Today is TUESDAY" << endl;
            break;
            case WEDNESDAY:
            cout << "Today is WEDNESDAY" << endl;
            break;
            case THURSDAY:
            cout << "Today is THURSDAY" << endl;
            break;
            case FRIDAY:
            cout << "Today is FRIDAY" << endl;
            break;
            case SATURDAY:
            cout << "Today is SATURDAY" << endl;
            break;
            case SUNDAY:
            cout << "Today is SUNDAY" << endl;
            break;
            default:
            cout << "Invalid day!" << endl;
    }
 // Start of part 3 the diffuclty section
    
    cout << "Start of Diffulty Section\n" << endl;
    cout << "Enter difficulty (1-3): ";
    cin >> dif;
    // cast the int input into diffulcty type so I can use it on the switch stament called diffucul

    Difficulty difficul = (Difficulty)dif;

     switch (difficul) {
         case EASY:
             cout << "You selected EASY diffulty" << endl;
             break;
         case MEDIUM:
             cout << "You selected MEDIUM diffulty" << endl;
             break;
             case HARD:
             cout << "You selected HARD diffulty" << endl;
             break;
         default: cout << "Invalid difficulty!" << endl;
     }
    return 0;
}


#include <algorithm>
#include <iostream>
#include <numeric>
#include <vector>
using namespace std;

vector<int> vec();
int main() {

    vector<int> hard = {10, 20, 30, 40, 50};
    vector<int> sec;
    vector<int> backup;
    int sum;
    double ave;
    int min = 100000000;
    int max = 1;

    cout << "\nYou have the following numbers in your basic vector: " << endl;

    for (int n : hard) {
        cout << n << " ";
    }

    // start of the second array code

    sec = vec();
    cout << "\nVector Numbers: ";
    for (int n : sec) {
        cout << n << " ";



    }


    backup = sec;
    cout << "\nYour arrays are backedup to your second array";


    hard.insert(hard.begin() + 3, 35);

    hard.erase(hard.begin());
    cout << "\nYou're new array is: ";

    for (int n : hard) {
        cout << n << " ";
    }

    sum = 0;


    for (int n : sec) {
        if (n < min) {
            min = n;
        } else if (n > max) {
            max = n;
        }
        sum += n;
    }
    cout << "\nMin: " << min << endl;
    cout << "Max: " << max << endl;
    cout << "Sum: " << sum << endl;

    ave = (float)sum / sec.size();
    cout << "Average: " << ave << endl;


    hard.insert(hard.end(), sec.begin(), sec.end());
    cout << "The 2 joined functions are: ";
    for (int n : hard) {
        cout << n << " ";
    }

return 0;
}



vector<int> vec() {
    int input;
    vector<int> num;
    cout << "\nPlease enter 10 numbers to push to the vector: " << endl;

    for (int i = 0; i < 10; i++) {

        cin >> input;
        num.push_back(input);

    }



    return num;


}

